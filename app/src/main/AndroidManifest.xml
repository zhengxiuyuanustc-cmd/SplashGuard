<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
    <application android:label="开屏清净" android:icon="@drawable/ic_shield" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <activity android:name=".SetupHelpActivity" android:exported="false"/>
        <activity android:name=".RuleReplayActivity" android:exported="false"/>
        <activity android:name=".ConfigBackupActivity" android:exported="false"/>
        <activity android:name=".OfflineToolsActivity" android:exported="false"/>
        <service android:name=".SkipService" android:label="开屏清净 · 自动跳过" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:stopWithTask="false">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/skip_service"/>
        </service>
    </application>
</manifest>
